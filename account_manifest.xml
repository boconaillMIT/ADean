<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="MailApp">
<Id>d7464f18-502d-4d69-a64d-cda1a772ba81</Id>
<Version>1.0.0.0</Version>
<ProviderName>MIT School of Engineering</ProviderName>
<DefaultLocale>en-US</DefaultLocale>
<DisplayName DefaultValue="Email to Account"/>
<Description DefaultValue="Reads a fund notification and pasted gift memo and proposes an Account record in QuickBase for review before it is created."/>
<IconUrl DefaultValue="https://waivercheck.netlify.app/icons/account-icon-80.png"/>
<HighResolutionIconUrl DefaultValue="https://waivercheck.netlify.app/icons/account-icon-128.png"/>
<SupportUrl DefaultValue="https://waivercheck.netlify.app/"/>
<Hosts>
<Host Name="Mailbox"/>
</Hosts>
<Requirements>
<Sets>
<Set Name="Mailbox" MinVersion="1.3"/>
</Sets>
</Requirements>
<FormSettings>
<Form xsi:type="ItemRead">
<DesktopSettings>
<SourceLocation DefaultValue="https://waivercheck.netlify.app/account.html"/>
<RequestedHeight>280</RequestedHeight>
</DesktopSettings>
</Form>
</FormSettings>
<Permissions>ReadItem</Permissions>
<Rule xsi:type="RuleCollection" Mode="Or">
<Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
</Rule>
<DisableEntityHighlighting>false</DisableEntityHighlighting>
<VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
<Requirements>
<bt:Sets DefaultMinVersion="1.3">
<bt:Set Name="Mailbox"/>
</bt:Sets>
</Requirements>
<Hosts>
<Host xsi:type="MailHost">
<DesktopFormFactor>
<ExtensionPoint xsi:type="MessageReadCommandSurface">
<OfficeTab id="TabDefault">
<Group id="accountGroup">
<Label resid="groupLabel"/>
<Control xsi:type="Button" id="accountButton">
<Label resid="btnLabel"/>
<Supertip>
<Title resid="btnLabel"/>
<Description resid="btnTip"/>
</Supertip>
<Icon>
<bt:Image size="16" resid="icon16"/>
<bt:Image size="32" resid="icon32"/>
<bt:Image size="80" resid="icon80"/>
</Icon>
<Action xsi:type="ShowTaskpane">
<SourceLocation resid="accountUrl"/>
</Action>
</Control>
</Group>
</OfficeTab>
</ExtensionPoint>
</DesktopFormFactor>
</Host>
</Hosts>
<Resources>
<bt:Images>
<bt:Image id="icon16" DefaultValue="https://waivercheck.netlify.app/icons/account-icon-16.png"/>
<bt:Image id="icon32" DefaultValue="https://waivercheck.netlify.app/icons/account-icon-32.png"/>
<bt:Image id="icon80" DefaultValue="https://waivercheck.netlify.app/icons/account-icon-80.png"/>
</bt:Images>
<bt:Urls>
<bt:Url id="accountUrl" DefaultValue="https://waivercheck.netlify.app/account.html"/>
</bt:Urls>
<bt:ShortStrings>
<bt:String id="groupLabel" DefaultValue="Finance Tools"/>
<bt:String id="btnLabel" DefaultValue="Email to Account"/>
</bt:ShortStrings>
<bt:LongStrings>
<bt:String id="btnTip" DefaultValue="Propose a QuickBase Account record from this email for you to review and create."/>
</bt:LongStrings>
</Resources>
</VersionOverrides>
</OfficeApp>


